#include <stdio.h>

int main(void)
{
    const int counts[] = {4000, 60000, 800000};
    const float bill_rupees = 950.00f;
    const long long bill_paise = 95000LL;

    for (int i = 0; i < 3; i++) {
        float float_total = 0.0f;
        long long paise_total = 0;

        for (int j = 0; j < counts[i]; j++) {
            float_total += bill_rupees;
            paise_total += bill_paise;
        }

        printf("%d bills: float Rs %.2f, paise Rs %lld.%02lld\n",
               counts[i], float_total,
               paise_total / 100, paise_total % 100);
    }

    return 0;
}
